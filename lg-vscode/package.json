{
  "name": "literarygiant-vscode",
  "displayName": "LiteraryGiant",
  "description": "LG 写作工作台：对话、作品概况、审批与版本差异",
  "version": "0.3.0",
  "publisher": "literarygiant",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:literarygiant.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "LG 需要启动本地后端并访问作品。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "literarygiant.open",
        "title": "LG：打开写作工作台"
      },
      {
        "command": "literarygiant.home",
        "title": "LG：返回作品首页"
      },
      {
        "command": "literarygiant.selectBook",
        "title": "LG：选择作品"
      },
      {
        "command": "literarygiant.models",
        "title": "LG：模型管理"
      },
      {
        "command": "literarygiant.reconnect",
        "title": "LG：重新连接"
      },
      {
        "command": "literarygiant.setup",
        "title": "LG：配置运行环境"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "literarygiant",
          "title": "LiteraryGiant",
          "icon": "media/lg.svg"
        }
      ]
    },
    "views": {
      "literarygiant": [
        {
          "id": "literarygiant.chat",
          "name": "LG 写作工作台",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "LiteraryGiant",
      "properties": {
        "literarygiant.backend": {
          "type": "string",
          "enum": [
            "literary",
            "codex"
          ],
          "default": "literary",
          "scope": "machine-overridable",
          "description": "两种选择均使用统一 LG 会话服务。literary 沿用 LG 执行器配置；codex 指定 Codex 执行器。旧 Extension 对话导入后在 LG 会话中接续，原始历史保留。"
        },
        "literarygiant.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "安装 LG 的 Python 绝对路径。"
        },
        "literarygiant.runtimeManifest": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Codex runtime.json 绝对路径；可留空沿用 LG 配置，Native 执行器不使用此项。"
        },
        "literarygiant.bookPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "现有 LG 作品路径，可相对当前工作区；留空时沿用 CLI 最近位置或当前书架。"
        },
        "literarygiant.environment": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "CLI 的 LG 配置空间；留空时使用 CLI 的默认规则。"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "markdown-it": "14.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@playwright/test": "^1.57.0",
    "@sparticuz/chromium": "143.0.4",
    "@types/markdown-it": "14.1.2",
    "@types/node": "20.19.1",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.6.0",
    "autoprefixer": "10.4.22",
    "esbuild": "0.25.3",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.3",
    "typescript": "5.8.2"
  }
}

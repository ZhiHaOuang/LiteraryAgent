{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteraryGiant stage output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "artifact_markdown": {
      "type": "string"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "established_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "established_facts",
        "assumptions",
        "constraints",
        "open_questions",
        "next_actions"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "story_index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characters": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "summary"
            ]
          }
        },
        "events": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "planned": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "summary",
              "planned"
            ]
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target",
              "label"
            ]
          }
        },
        "links": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target",
              "label"
            ]
          }
        }
      },
      "required": [
        "characters",
        "events",
        "relationships",
        "links"
      ]
    },
    "book_overview": {
      "type": "string",
      "maxLength": 500,
      "description": "One concise Chinese sentence about the whole book, updated with generated prose; not a chapter recap. Empty only for non-prose stages."
    }
  },
  "required": [
    "summary",
    "artifact_markdown",
    "handoff",
    "risks",
    "book_overview"
  ]
}

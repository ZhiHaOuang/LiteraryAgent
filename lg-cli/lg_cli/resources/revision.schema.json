{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteraryGiant revision output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string"},
    "revision_markdown": {"type": "string"},
    "change_log": {"type": "array", "items": {"type": "string"}},
    "memory_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {"type": "string"},
          "key": {"type": "string"},
          "value": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"}
        },
        "required": ["category", "key", "value", "tags", "rationale"]
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["summary", "revision_markdown", "change_log", "memory_proposals", "risks"]
}

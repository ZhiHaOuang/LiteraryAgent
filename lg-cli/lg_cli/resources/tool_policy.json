{
  "schema_version": "lg.tool_policy.v1",
  "default": {
    "allow": ["memory_read", "reference_search"],
    "deny": ["shell_command", "apply_patch", "network"]
  },
  "modes": {
    "CodeMode": {
      "allow": ["read_file", "search_file", "apply_patch", "shell_command", "git_diff"],
      "deny": []
    },
    "OutlineMode": {
      "allow": ["read_file", "search_file", "reference_search", "memory_read", "write_output"],
      "deny": ["shell_command"]
    },
    "WorldbuildingMode": {
      "allow": ["read_file", "reference_search", "memory_read", "write_output"],
      "deny": ["shell_command"]
    },
    "ChapterWritingMode": {
      "allow": ["read_file", "reference_search", "memory_read", "memory_update", "write_output"],
      "deny": ["shell_command"]
    },
    "ConsistencyCheckMode": {
      "allow": ["read_file", "search_file", "reference_search", "memory_read", "write_report"],
      "deny": ["shell_command"]
    },
    "ReferenceMode": {
      "allow": ["read_file", "search_file", "reference_search", "reference_abstract"],
      "deny": ["shell_command"]
    }
  }
}

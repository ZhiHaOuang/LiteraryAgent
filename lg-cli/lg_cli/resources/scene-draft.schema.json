{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteraryGiant scene draft output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "draft_markdown": {
      "type": "string"
    },
    "continuity_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "key",
          "value",
          "tags",
          "rationale"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "story_index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characters": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "summary"
            ]
          }
        },
        "events": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "planned": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "summary",
              "planned"
            ]
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target",
              "label"
            ]
          }
        },
        "links": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target",
              "label"
            ]
          }
        }
      },
      "required": [
        "characters",
        "events",
        "relationships",
        "links"
      ]
    },
    "book_overview": {
      "type": "string",
      "maxLength": 500,
      "description": "One concise Chinese sentence about the whole book, updated with generated prose; not a chapter recap. Empty only for non-prose stages.",
      "minLength": 1
    }
  },
  "required": [
    "summary",
    "draft_markdown",
    "continuity_notes",
    "memory_proposals",
    "risks",
    "book_overview"
  ]
}

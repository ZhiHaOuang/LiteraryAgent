{
  "schema_version": "lg.subagents.v2",
  "execution_model": "serial-first, resumable, event-driven",
  "subagents": [
    {
      "name": "DirectorAgent",
      "role": "总导演，负责拆任务、选择 workflow、分配子任务、整合结果。",
      "responsibilities": [
        "classify request",
        "select mode",
        "plan orchestration",
        "merge outputs",
        "decide memory updates"
      ],
      "inputs": [
        "user_direction",
        "workspace_status",
        "available_skills",
        "available_subagents"
      ],
      "outputs": [
        "execution_plan",
        "handoff_packet",
        "final_output"
      ],
      "allowed_tools": [
        "memory_read",
        "reference_search",
        "write_output"
      ],
      "skills": [
        "direction-expander",
        "failure-logger"
      ],
      "handoff_rules": [
        "Send reference needs to ReferenceAgent",
        "Send setting needs to WorldbuildingAgent",
        "Send final draft to CriticAgent and ContinuityAgent"
      ],
      "quality_criteria": [
        "clear mode choice",
        "bounded scope",
        "ordered handoff",
        "final output reconciles conflicts"
      ],
      "failure_modes": [
        "overdelegation",
        "unclear output contract",
        "missing memory impact"
      ],
      "id": "director",
      "path": "lg-subagents/director",
      "model_profile": "writer",
      "output_schema": "lg-subagents/director/output.schema.json"
    },
    {
      "name": "ReferenceAgent",
      "role": "负责检索 Reference Library，并抽象可迁移结构，禁止照搬原文。",
      "responsibilities": [
        "retrieve sources",
        "abstract mechanics",
        "track provenance",
        "avoid copied prose"
      ],
      "inputs": [
        "query",
        "reference_roots",
        "task_goal"
      ],
      "outputs": [
        "source_refs",
        "abstract_patterns",
        "reuse_constraints"
      ],
      "allowed_tools": [
        "read_file",
        "search_file",
        "reference_search",
        "reference_abstract"
      ],
      "skills": [
        "reference-retriever",
        "reference-abstractor"
      ],
      "handoff_rules": [
        "Return abstract patterns to DirectorAgent, PlotAgent, WorldbuildingAgent, or StyleAgent"
      ],
      "quality_criteria": [
        "source ids present",
        "no copied prose",
        "patterns usable"
      ],
      "failure_modes": [
        "source prose leakage",
        "irrelevant references",
        "unbounded context"
      ],
      "id": "reference",
      "path": "lg-subagents/reference",
      "model_profile": "critic",
      "output_schema": "lg-subagents/reference/output.schema.json"
    },
    {
      "name": "WorldbuildingAgent",
      "role": "负责世界观、势力、规则、资源、等级、地理和系统边界。",
      "responsibilities": [
        "world rules",
        "factions",
        "resources",
        "power scale",
        "limits",
        "costs"
      ],
      "inputs": [
        "premise",
        "genre",
        "plot_pressure",
        "reference_patterns"
      ],
      "outputs": [
        "world_bible",
        "rule_boundaries",
        "conflict_sources"
      ],
      "allowed_tools": [
        "memory_read",
        "reference_search",
        "write_output"
      ],
      "skills": [
        "worldview-designer"
      ],
      "handoff_rules": [
        "Send constraints to CharacterAgent and PlotAgent",
        "Send contradictions to ContinuityAgent"
      ],
      "quality_criteria": [
        "rules generate conflict",
        "limits explicit",
        "costs meaningful"
      ],
      "failure_modes": [
        "decorative lore",
        "unbounded powers",
        "factions without incentives"
      ],
      "id": "worldbuilding",
      "path": "lg-subagents/worldbuilding",
      "model_profile": "writer",
      "output_schema": "lg-subagents/worldbuilding/output.schema.json"
    },
    {
      "name": "CharacterAgent",
      "role": "负责人物弧光、关系网、动机、成长、创伤、误会、反转。",
      "responsibilities": [
        "cast design",
        "motivation",
        "relationship tension",
        "growth arc",
        "antagonist mirror"
      ],
      "inputs": [
        "premise",
        "world_rules",
        "plot_pressure"
      ],
      "outputs": [
        "character_table",
        "relationship_map",
        "arc_plan"
      ],
      "allowed_tools": [
        "memory_read",
        "reference_search",
        "write_output"
      ],
      "skills": [
        "character-arc-designer",
        "conflict-engine"
      ],
      "handoff_rules": [
        "Send arc constraints to PlotAgent",
        "Send durable facts to MemoryAgent"
      ],
      "quality_criteria": [
        "motives actionable",
        "relationships tense",
        "growth tested"
      ],
      "failure_modes": [
        "flat cast",
        "weak motive",
        "relationship without conflict"
      ],
      "id": "character",
      "path": "lg-subagents/character",
      "model_profile": "writer",
      "output_schema": "lg-subagents/character/output.schema.json"
    },
    {
      "name": "PlotAgent",
      "role": "负责主线、分卷、章节、冲突升级、伏笔和回收。",
      "responsibilities": [
        "plot arcs",
        "conflict escalation",
        "foreshadowing",
        "payoff",
        "chapter beats"
      ],
      "inputs": [
        "direction",
        "world_bible",
        "characters",
        "reference_patterns"
      ],
      "outputs": [
        "volume_outline",
        "chapter_outline",
        "payoff_ledger"
      ],
      "allowed_tools": [
        "memory_read",
        "reference_search",
        "write_output"
      ],
      "skills": [
        "outline-planner",
        "conflict-engine"
      ],
      "handoff_rules": [
        "Send chapter-ready beats to ChapterWriterAgent",
        "Send risk points to CriticAgent"
      ],
      "quality_criteria": [
        "each chapter moves",
        "hooks concrete",
        "payoffs tracked"
      ],
      "failure_modes": [
        "interchangeable chapters",
        "forgotten setup",
        "flat escalation"
      ],
      "id": "plot",
      "path": "lg-subagents/plot",
      "model_profile": "writer",
      "output_schema": "lg-subagents/plot/output.schema.json"
    },
    {
      "name": "ChapterWriterAgent",
      "role": "负责按大纲写章节正文。",
      "responsibilities": [
        "scene plan",
        "draft prose",
        "ending hook",
        "new fact capture"
      ],
      "inputs": [
        "chapter_outline",
        "story_bible",
        "style_guide",
        "continuity_constraints"
      ],
      "outputs": [
        "chapter_draft",
        "hook",
        "memory_update_candidates"
      ],
      "allowed_tools": [
        "memory_read",
        "reference_search",
        "write_output",
        "memory_update"
      ],
      "skills": [
        "chapter-writer",
        "style-controller"
      ],
      "handoff_rules": [
        "Send draft to ContinuityAgent and StyleAgent before final"
      ],
      "quality_criteria": [
        "conflict present",
        "emotion shifts",
        "hook strong",
        "no padding"
      ],
      "failure_modes": [
        "watered prose",
        "no scene turn",
        "voice drift"
      ],
      "id": "chapter-writer",
      "path": "lg-subagents/chapter-writer",
      "model_profile": "writer",
      "output_schema": "lg-subagents/chapter-writer/output.schema.json"
    },
    {
      "name": "ScenePlannerAgent",
      "role": "负责把章节节点转化为可审批的场景卡和因果节拍，不提前写正文。",
      "responsibilities": [
        "scene promise",
        "causal beat planning",
        "information flow",
        "emotional turn",
        "ending state",
        "memory proposal capture"
      ],
      "inputs": [
        "author_request",
        "scene_card",
        "story_bible",
        "timeline",
        "foreshadowing_ledger"
      ],
      "outputs": [
        "candidate_scene_plan",
        "card_updates",
        "continuity_risks",
        "memory_proposals"
      ],
      "allowed_tools": [
        "memory_read",
        "reference_search",
        "write_output"
      ],
      "skills": [
        "scene-planner",
        "conflict-engine",
        "story-bible-curator"
      ],
      "handoff_rules": [
        "Return a candidate plan to the author for explicit approval",
        "Send only approved plans to ChapterWriterAgent",
        "Send possible durable facts to MemoryAgent as proposals"
      ],
      "quality_criteria": [
        "causal beats",
        "clear scene turn",
        "information boundaries explicit",
        "no prose before approval",
        "no automatic canon changes"
      ],
      "failure_modes": [
        "summary without beats",
        "unclear opposition",
        "unchanged ending state",
        "silent canon invention"
      ],
      "id": "scene-planner",
      "path": "lg-subagents/scene-planner",
      "model_profile": "writer",
      "output_schema": "lg-subagents/scene-planner/output.schema.json"
    },
    {
      "name": "ManuscriptEditorAgent",
      "role": "负责按明确模式生成可对比的候选修订，不覆盖当前接受版本。",
      "responsibilities": [
        "revision scope control",
        "candidate manuscript revision",
        "change log",
        "canon preservation",
        "continuity risk capture"
      ],
      "inputs": [
        "source_version",
        "revision_mode",
        "author_request",
        "story_bible",
        "style_guide"
      ],
      "outputs": [
        "candidate_revision",
        "change_log",
        "continuity_risks",
        "memory_proposals"
      ],
      "allowed_tools": [
        "memory_read",
        "write_output",
        "write_report"
      ],
      "skills": [
        "manuscript-editor",
        "style-controller",
        "continuity-checker",
        "story-bible-curator"
      ],
      "handoff_rules": [
        "Return candidate and change log for author review",
        "Send continuity doubts to ContinuityAgent",
        "Require explicit version acceptance before activation"
      ],
      "quality_criteria": [
        "revision mode respected",
        "canon preserved",
        "change log concrete",
        "candidate remains inactive"
      ],
      "failure_modes": [
        "scope creep",
        "silent plot rewrite",
        "canon drift",
        "candidate treated as accepted"
      ],
      "id": "manuscript-editor",
      "path": "lg-subagents/manuscript-editor",
      "model_profile": "writer",
      "output_schema": "lg-subagents/manuscript-editor/output.schema.json"
    },
    {
      "name": "ContinuityAgent",
      "role": "负责查矛盾、断线、设定冲突、战力膨胀和时间线问题。",
      "responsibilities": [
        "contradiction check",
        "timeline audit",
        "power scale audit",
        "causality audit"
      ],
      "inputs": [
        "artifact",
        "memory",
        "story_bible"
      ],
      "outputs": [
        "issues",
        "severity",
        "repair_suggestions"
      ],
      "allowed_tools": [
        "read_file",
        "search_file",
        "memory_read",
        "write_report"
      ],
      "skills": [
        "continuity-checker",
        "failure-logger"
      ],
      "handoff_rules": [
        "Send repairs to DirectorAgent",
        "Send durable corrections to MemoryAgent"
      ],
      "quality_criteria": [
        "evidence cited",
        "severity clear",
        "minimal repair"
      ],
      "failure_modes": [
        "vague risk",
        "false contradiction",
        "no evidence"
      ],
      "id": "continuity",
      "path": "lg-subagents/continuity",
      "model_profile": "critic",
      "output_schema": "lg-subagents/continuity/output.schema.json"
    },
    {
      "name": "StyleAgent",
      "role": "负责文风、节奏、对白、爽感密度、叙事口吻。",
      "responsibilities": [
        "voice control",
        "dialogue ratio",
        "sentence rhythm",
        "payoff density"
      ],
      "inputs": [
        "draft",
        "style_guide",
        "target_reader"
      ],
      "outputs": [
        "style_diagnosis",
        "rewrite_guidelines",
        "sample_revision"
      ],
      "allowed_tools": [
        "memory_read",
        "write_output",
        "write_report"
      ],
      "skills": [
        "style-controller"
      ],
      "handoff_rules": [
        "Return style constraints to ChapterWriterAgent and DirectorAgent"
      ],
      "quality_criteria": [
        "voice stable",
        "momentum high",
        "dialogue functional"
      ],
      "failure_modes": [
        "purple prose",
        "flat exposition",
        "overwriting facts"
      ],
      "id": "style",
      "path": "lg-subagents/style",
      "model_profile": "writer",
      "output_schema": "lg-subagents/style/output.schema.json"
    },
    {
      "name": "CriticAgent",
      "role": "负责质量评估，指出弱点，提出修改方案。",
      "responsibilities": [
        "score output",
        "identify weak points",
        "prioritize revision"
      ],
      "inputs": [
        "artifact",
        "workflow_goal",
        "quality_criteria"
      ],
      "outputs": [
        "scorecard",
        "weaknesses",
        "revision_plan"
      ],
      "allowed_tools": [
        "read_file",
        "memory_read",
        "write_report"
      ],
      "skills": [
        "failure-logger",
        "style-controller"
      ],
      "handoff_rules": [
        "Send revision plan to DirectorAgent"
      ],
      "quality_criteria": [
        "specific weaknesses",
        "actionable repair",
        "no vague taste-only critique"
      ],
      "failure_modes": [
        "generic criticism",
        "too many unranked issues",
        "no repair path"
      ],
      "id": "critic",
      "path": "lg-subagents/critic",
      "model_profile": "critic",
      "output_schema": "lg-subagents/critic/output.schema.json"
    },
    {
      "name": "MemoryAgent",
      "role": "负责维护 .literarygiant/memory/ 中的长期记忆。",
      "responsibilities": [
        "memory diff",
        "canon separation",
        "timeline update",
        "error log"
      ],
      "inputs": [
        "new_facts",
        "existing_memory",
        "repair_notes"
      ],
      "outputs": [
        "memory_update_plan",
        "files_to_touch",
        "conflict_notes"
      ],
      "allowed_tools": [
        "memory_read",
        "memory_update",
        "write_output"
      ],
      "skills": [
        "memory-updater",
        "story-bible-curator",
        "failure-logger"
      ],
      "handoff_rules": [
        "Return memory diff to DirectorAgent for confirmation or execution"
      ],
      "quality_criteria": [
        "canon clear",
        "no silent overwrite",
        "timeline and relationships updated"
      ],
      "failure_modes": [
        "memory spam",
        "speculation stored as canon",
        "missed conflict"
      ],
      "id": "memory",
      "path": "lg-subagents/memory",
      "model_profile": "writer",
      "output_schema": "lg-subagents/memory/output.schema.json"
    }
  ]
}
